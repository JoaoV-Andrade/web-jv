# Resend (e-mails de notificação)
RESEND_API_KEY=""

# Telegram (notificações)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Proteção dos endpoints de cron
CRON_SECRET=""

# Vercel Blob (upload de fotos na Wishlist)
BLOB_READ_WRITE_TOKEN=""
